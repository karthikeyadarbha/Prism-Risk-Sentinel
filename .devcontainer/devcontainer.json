{
  "name": "Prism Risk Sentinel - Anaconda",
  "image": "continuumio/anaconda3:latest",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "conda init bash && echo 'Container ready'",
  "remoteUser": "root",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
        "version": "latest"
    }
  }
}