{
  "datasets": [
    {
      "name": "ce512f16",
      "displayName": "Potential Risk Assessment Summary",
      "queryLines": [
        "SELECT \r\n",
        "  'Worst Case Exposure (95th %)' as metric,\r\n",
        "  round(percentile_approx(potential_exposure, 0.95), 2) as value\r\n",
        "FROM `prism-sentinel-stream`.prism_gold.risk_simulation_results;"
      ]
    },
    {
      "name": "9ed1d43e",
      "displayName": "Global Alert Summary by Country",
      "queryLines": [
        "SELECT \r\n",
        "  country, \r\n",
        "  sum(amount) as alerted_value,\r\n",
        "  count(*) as alert_count\r\n",
        "FROM `prism-sentinel-stream`.prism_silver.transactions_refined\r\n",
        "WHERE risk_flag = 'ALERT'\r\n",
        "GROUP BY country\r\n",
        "ORDER BY alerted_value DESC;"
      ]
    },
    {
      "name": "71738f2c",
      "displayName": "Top 10 Fuzzy Match Leads",
      "queryLines": [
        "SELECT \n",
        "  counterparty,\n",
        "  entity_name,\n",
        "  similarity_score,\n",
        "  risk_level,\n",
        "  COUNT(*) as transaction_count,\n",
        "  SUM(amount) as total_amount\n",
        "FROM transactions_refined\n",
        "WHERE similarity_score IS NOT NULL\n",
        "GROUP BY counterparty, entity_name, similarity_score, risk_level\n",
        "ORDER BY similarity_score DESC\n",
        "LIMIT 10"
      ],
      "catalog": "prism-sentinel-stream",
      "schema": "prism_silver"
    }
  ],
