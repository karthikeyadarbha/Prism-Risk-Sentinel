{
  "datasets": [
    {
      "name": "209f47aa",
      "displayName": "The Monte-Carlo VaR Distribution",
      "queryLines": [
        "SELECT \r\n",
        "    potential_exposure,\r\n",
        "    CASE \r\n",
        "        WHEN potential_exposure >= (SELECT approx_percentile(potential_exposure, 0.95) FROM `prism-sentinel-stream`.prism_gold.risk_simulation_results) \r\n",
        "        THEN 'Critical Risk (Top 5%)' \r\n",
        "        ELSE 'Expected Volatility' \r\n",
        "    END as risk_zone\r\n",
        "FROM `prism-sentinel-stream`.prism_gold.risk_simulation_results"
      ]
    },
    {
      "name": "8f6ef9d2",
      "displayName": "Fraud Probability Distribution (Individual Level)",
      "queryLines": [
        "-- Query to power the 'Fraud Probability Density' widget\r\n",
        "-- Visualize as: Area Chart or Density Plot\r\n",
        "-- X-Axis: fraud_probability_bucket | Y-Axis: transaction_count\r\n",
        "WITH ProbabilityBuckets AS (\r\n",
        "    SELECT \r\n",
        "        transaction_id,\r\n",
        "        -- Normalizing hits into 0.0-1.0 probability\r\n",
        "        round(simulation_hits / 10000.0, 2) as fraud_probability\r\n",
        "    FROM `prism-sentinel-stream`.prism_gold.risk_gold_monte_carlo\r\n",
        ")\r\n",
        "SELECT \r\n",
        "    fraud_probability,\r\n",
        "    count(transaction_id) as txn_count,\r\n",
        "    CASE \r\n",
        "        WHEN fraud_probability > 0.85 THEN '🔴 CRITICAL (SAR Candidate)'\r\n",
        "        WHEN fraud_probability > 0.50 THEN '🟡 HIGH (Manual Review)'\r\n",
        "        WHEN fraud_probability > 0.20 THEN '🔵 MEDIUM (Pattern Detected)'\r\n",
        "        ELSE '🟢 LOW (Baseline)'\r\n",
        "    END as risk_segment\r\n",
        "FROM ProbabilityBuckets\r\n",
        "GROUP BY 1\r\n",
        "ORDER BY 1 DESC;  \r\n",
        "\r\n"
      ]
    }
  ],
